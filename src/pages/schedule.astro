---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";

const weekDays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const monthNames = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

const buildMonth = (monthIndex, year, location, locationShort) => {
  const firstDay = new Date(year, monthIndex, 1);
  const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();
  const startDay = firstDay.getDay();
  const weeks = [];
  let day = 1;

  while (day <= daysInMonth) {
    const week = Array(7).fill(null);
    for (let i = 0; i < 7; i += 1) {
      if (weeks.length === 0 && i < startDay) continue;
      if (day > daysInMonth) break;
      week[i] = day;
      day += 1;
    }
    weeks.push(week);
  }

  return {
    key: `${year}-${monthIndex + 1}`,
    label: `${monthNames[monthIndex]} ${year}`,
    shortLabel: monthNames[monthIndex].slice(0, 3),
    year,
    monthIndex,
    location,
    locationShort,
    weeks,
  };
};

const seasonMonthsConfig = [
  { monthIndex: 9, year: 2026, location: "North Fork High School", locationShort: "NFHS" },
  { monthIndex: 10, year: 2026, location: "Delta High School", locationShort: "DHS" },
  { monthIndex: 11, year: 2026, location: "Delta High School", locationShort: "DHS" },
];

const seasonMonths = seasonMonthsConfig.map(({ monthIndex, year, location, locationShort }) =>
  buildMonth(monthIndex, year, location, locationShort)
);

const now = new Date();
const currentMonthIndex = seasonMonthsConfig.findIndex(
  (month) => month.monthIndex === now.getMonth() && month.year === now.getFullYear()
);
const defaultMonthIndex = currentMonthIndex >= 0 ? currentMonthIndex : 0;
const defaultMonth = seasonMonths[defaultMonthIndex] ?? seasonMonths[0];

const practiceStartDate = "2026-10-07";
const practiceEndDate = "2026-12-31";
const noPracticeDates = new Set(["2026-11-25", "2026-12-23"]);
---

<BaseLayout
  title="Schedule | Midway Wrestling Club"
  description="Schedule details, what to bring, and pricing for Midway Wrestling Club."
>
  <Section className="section-tight">
    <div class="calendar-hero card">
      <div class="calendar-hero__head">
        <div class="calendar-summary" aria-live="polite">
          <p class="eyebrow">Season Calendar</p>
          <h3 class="calendar-title" data-calendar-month-label>{defaultMonth.label}</h3>
          <p class="muted" data-calendar-location>Practice location: {defaultMonth.location}</p>
        </div>
        <div class="calendar-controls" role="tablist" aria-label="Select month">
          {seasonMonths.map((month, index) => (
            <button
              class={`month-toggle${index === defaultMonthIndex ? " is-active" : ""}`}
              type="button"
              data-month-button={month.key}
              data-month-label={month.label}
              data-month-location={month.location}
              aria-pressed={index === defaultMonthIndex ? "true" : "false"}
            >
              {month.shortLabel}
            </button>
          ))}
        </div>
      </div>
      <div class="calendar-panels">
        {seasonMonths.map((month, index) => (
          <div
            class={`calendar-month${index === defaultMonthIndex ? " is-active" : ""}`}
            data-month-panel={month.key}
            aria-hidden={index === defaultMonthIndex ? "false" : "true"}
          >
            <div class="calendar-weekdays">
              {weekDays.map((day) => (
                <span class="calendar-weekday">{day}</span>
              ))}
            </div>
            <div class="calendar-days">
              {month.weeks.map((week) =>
                week.map((day, dayIndex) => {
                  if (!day) {
                    return <span class="calendar-day is-empty" aria-hidden="true"></span>;
                  }
                  const dateKey = `${month.year}-${String(month.monthIndex + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
                  const isPractice =
                    (dayIndex === 1 || dayIndex === 3) &&
                    dateKey >= practiceStartDate &&
                    dateKey <= practiceEndDate &&
                    !noPracticeDates.has(dateKey);
                  const label = isPractice
                    ? "Practice, 6:45-8:00pm, " + month.location
                    : null;
                  return (
                    <span
                      class={`calendar-day${isPractice ? " is-practice" : ""}`}
                      aria-label={`${month.label} ${day}${label ? `, ${label}` : ""}`}
                    >
                      <span class="calendar-day__number">{day}</span>
                      {isPractice && (
                        <span class="calendar-day__practice" aria-hidden="true">
                          <img
                            class="calendar-day__icon"
                            src="/logos/redhat_no_bg.png"
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                          <span
                            class={`calendar-day__location${month.locationShort.length > 3 ? " is-compact" : ""}`}
                          >
                            {month.locationShort}
                          </span>
                        </span>
                      )}
                    </span>
                  );
                })
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="calendar-legend">
        <span class="calendar-legend__swatch" aria-hidden="true">
          <img
            class="calendar-legend__icon"
            src="/logos/redhat_no_bg.png"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="calendar-legend__equals" aria-hidden="true">=</span>
        <p class="calendar-legend__text">
          Practice <span aria-hidden="true">•</span> 6:45-8:00pm
        </p>
        <p class="calendar-legend__text">
          NFHS = North Fork High School <span aria-hidden="true">•</span> DHS = Delta High School
        </p>
      </div>
    </div>
  </Section>

  <script is:inline define:vars={{ defaultMonthIndex }}>
    const monthButtons = document.querySelectorAll("[data-month-button]");
    const monthPanels = document.querySelectorAll("[data-month-panel]");
    const monthLabel = document.querySelector("[data-calendar-month-label]");
    const locationLabel = document.querySelector("[data-calendar-location]");

    const setActiveMonth = (key) => {
      monthPanels.forEach((panel) => {
        const isActive = panel.getAttribute("data-month-panel") === key;
        panel.classList.toggle("is-active", isActive);
        panel.setAttribute("aria-hidden", String(!isActive));
      });
      monthButtons.forEach((button) => {
        const isActive = button.getAttribute("data-month-button") === key;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
        if (isActive) {
          if (monthLabel) {
            monthLabel.textContent = button.getAttribute("data-month-label") || "";
          }
          if (locationLabel) {
            const location = button.getAttribute("data-month-location") || "";
            locationLabel.textContent = `Practice location: ${location}`;
          }
        }
      });
    };

    monthButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.getAttribute("data-month-button");
        if (key) setActiveMonth(key);
      });
    });

    if (monthButtons.length) {
      const initialIndex =
        Number.isInteger(defaultMonthIndex) && defaultMonthIndex >= 0
          ? defaultMonthIndex
          : 0;
      const initialKey =
        monthButtons[initialIndex]?.getAttribute("data-month-button") ||
        monthButtons[0].getAttribute("data-month-button");
      if (initialKey) setActiveMonth(initialKey);
    }
  </script>
</BaseLayout>
