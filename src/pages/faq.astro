---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTAButtons from "../components/CTAButtons.astro";

const faqItems = [
  {
    question: "Is this for beginners?",
    answer:
      "Midway is currently geared toward wrestlers ages 10 through high school who already have a solid foundation in the sport. Three to four years of wrestling experience is highly recommended. Message us on Facebook to see if Midway practices are the right fit for your wrestler.",
  },
  {
    question: "What gear do I need?",
    answer: "Wrestling shoes and athletic clothing.",
  },
  {
    question: "How do I sign up?",
    answer:
      "Message the Midway Wrestling Club Facebook page to confirm that practices are the right fit and that space is available. Once confirmed, use the Membership page to pay.",
  },
  {
    question: "Can parents watch?",
    answer:
      "Yes, parents are welcome to stay and watch practice or drop off and pick up their wrestler at the end.",
  },
  {
    question: "How often are practices?",
    answer: "Practices are held Mondays and Wednesdays from 6:45-8:00 PM.",
  },
  {
    question: "Where are practices?",
    answer:
      "October practices are at North Fork High School. November and December practices are at Delta High School.",
  },
  {
    question: "What is the drop-in cost?",
    answer: "$20 per practice. Ask us about sibling/family discounts.",
  },
  {
    question: "What is the monthly cost?",
    answer: "$100 per month for one wrestler.",
  },
  {
    question: "Are there discounts for multiple wrestlers?",
    answer:
      "Yes. Monthly family pricing is $100 total for one wrestler, $150 total for two wrestlers, and $175 total for three or more wrestlers.",
  },
];
---

<BaseLayout
  title="FAQ | Midway Wrestling Club"
  description="Frequently asked questions about practice, gear, and joining Midway Wrestling Club."
>
  <Section
    eyebrow="FAQ"
    title="Questions, answered"
    intro="Quick answers for parents and athletes."
  >
    <FAQAccordion items={faqItems} baseId="faq-main" />
  </Section>

  <Section
    eyebrow="Contact"
    title="Still deciding?"
    intro="Message the Midway Wrestling Club Facebook page with questions about schedules, pricing, or skill level."
  >
    <CTAButtons
      primaryLabel="Message on Facebook"
      primaryHref="https://www.facebook.com/share/184nobE311/?mibextid=wwXIfr"
      flipPrimary={false}
      secondaryLabel="Email Coach"
      secondaryHref="mailto:Midwaywrestlingclub@gmail.com"
      secondaryVariant="outline"
    />
  </Section>
</BaseLayout>
